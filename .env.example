# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== MT5 (Option A) =====
MT5_LOGIN=
MT5_PASSWORD=''
MT5_SERVER=ICMarketsSC-Demo

# ===== OANDA (Option B) =====
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# ===== MOEX (Option C) =====
# Market: "forts" (futures) or "shares" (TQBR stocks)
MOEX_MARKET=forts

# ===== GENERAL =====
# Data provider: "mt5", "oanda", "csv", or "moex"
DATA_PROVIDER=moex
# Timezone: "UTC", "Europe/Helsinki", "Europe/Moscow"
TIMEZONE=Europe/Moscow

# ===== PAPER TRADING =====
PAPER_ENABLED=true
PAPER_INITIAL_CAPITAL=100000
PAPER_POSITION_PCT_LONG=100
PAPER_POSITION_PCT_SHORT=50
PAPER_MAX_CONCURRENT=3
PAPER_COST_PCT=0.26
